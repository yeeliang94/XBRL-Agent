# XBRL Agent configuration
# Copy to .env and fill in credentials for your selected provider.
# Keep .env private; use placeholders only in .env.example.
# Settings saved in the app override these values. They are stored in
# output/settings.json by default (or XBRL_SETTINGS_FILE when configured).

# --- Provider connections ---
# Empty LLM_PROXY_URL selects direct provider access on either platform.
# Direct OpenAI uses OPENAI_API_KEY; direct Claude uses ANTHROPIC_API_KEY;
# direct Gemini uses GOOGLE_API_KEY, falling back to GEMINI_API_KEY.
# A local proxy's Gemini bypass prefers GEMINI_API_KEY over GOOGLE_API_KEY.
LLM_PROXY_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Proxy auth prefers LLM_PROXY_API_KEY, then GOOGLE_API_KEY, then GEMINI_API_KEY.
# Enterprise proxy credentials come from Bruno's Auth tab.
# LLM_PROXY_API_KEY=

# --- Model defaults and role overrides ---
# App default from model_settings.py; see config/models.json for model IDs.
# Direct access with this default requires OPENAI_API_KEY.
TEST_MODEL=openai.global.gpt-5.6-luna
# Legacy Document scan fallback; a saved role override wins.
# Leave unset to inherit TEST_MODEL.
# SCOUT_MODEL=openai.global.gpt-5.6-luna
# Optional JSON objects, normally managed in Settings. Single-quote JSON.
# XBRL_DEFAULT_MODELS='{"reviewer":"openai.global.gpt-5.6-luna"}'
# XBRL_THINKING_LEVELS='{"reviewer":"low"}'
# Readable OpenAI Responses summaries, independent of reasoning effort.
XBRL_REASONING_SUMMARY=auto

# --- Review and notes preferences ---
# Boolean options use true/false. Commented values below show app defaults.
# XBRL_AUTO_REVIEW=true
# XBRL_NOTES_AUTO_REVIEW=true
# XBRL_ENTITY_MEMORY=true
# Integrity: off | shadow | enforce. Shadow records the assessment;
# enforce can mark a run completed_with_errors for unresolved source content.
# XBRL_NOTES_SOURCE_INTEGRITY=off
# Leave unset for the house notes-table theme. Explicit {} uses historic
# per-surface defaults. Configure custom JSON through Settings.
# XBRL_NOTES_TABLE_STYLE='{}'

# --- Server and storage ---
# Loopback is the default; 0.0.0.0 exposes the login form to the network.
HOST=127.0.0.1
PORT=8002
# Defaults: <project>/output and <output directory>/settings.json.
# XBRL_OUTPUT_DIR=
# XBRL_SETTINGS_FILE=

# --- Authentication ---
# Leave AUTH_MODE unset for email/password login. dev bypasses login for
# CI/offline work and is refused on Azure (WEBSITE_SITE_NAME present).
# AUTH_MODE=dev
# Production requires SESSION_SECRET. Generate one on macOS/Linux with:
#   venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
# On Windows use venv\Scripts\python.exe instead of venv/bin/python.
SESSION_SECRET=
# Local development only: set BOTH email and password to bootstrap an admin.
# Password must be at least 8 characters. Restarts preserve changed passwords
# and do not re-enable disabled accounts.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Local Admin
# For shared/production instances, provision an admin with:
#   venv/bin/python -m auth.manage add-user you@firm.com --name "Your Name" --admin
# Sliding idle timeout and login lockout window, in seconds.
# AUTH_IDLE_TIMEOUT_S=900
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_LOCKOUT_S=900

# --- Observability and retention ---
# Optional rotating structured JSON log file (unset: console logging only).
# XBRL_APP_LOG_PATH=/var/log/xbrl-agent/app.jsonl
# XBRL_APP_LOG_MAX_BYTES=10485760
# XBRL_APP_LOG_BACKUPS=5
# XBRL_LOG_LEVEL=INFO
# Traces and notes failure logs contain source/model content. Default: 90 days.
# Use 0 only when an external system manages retention.
# XBRL_TRACE_RETENTION_DAYS=90

# --- Advanced settings ---
# Feature switches and limits listed in settings_catalog.py (including
# XBRL_LOG_LEVEL, XBRL_TRACE_RETENTION_DAYS and the two below) are managed in
# Settings > Advanced settings. A value saved there overrides this file; a
# value here is only the fallback.
# OpenAI models always use the Responses API, direct or through a proxy.
# Opt in to the GPT-5.6 cache-options request shape only after live validation.
# XBRL_OPENAI_CACHE_OPTIONS=
# Allow remote Gemini proxy routing only if thought signatures are preserved.
# XBRL_ALLOW_GEMINI_PROXY=
